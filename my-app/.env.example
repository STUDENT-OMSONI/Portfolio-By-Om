# ==============================================================================
# Vite Environment Configuration (Template)
# Copy this file to '.env' or '.env.local' and fill in your actual values.
# NOTE: Only variables prefixed with VITE_ are exposed to your client-side code.
# ==============================================================================

# Application Metadata
VITE_APP_TITLE="Om Soni | Data Analyst & AI Developer Portfolio"
VITE_OWNER_NAME="Om Soni"
VITE_CONTACT_EMAIL="omsoni@example.com"

# API & Backend Services
VITE_API_BASE_URL="http://localhost:5000/api"
VITE_POTHOLE_API_URL="http://localhost:8000"

# Contact Form / Email Service (e.g. EmailJS or Formspree)
VITE_EMAILJS_SERVICE_ID="your_service_id"
VITE_EMAILJS_TEMPLATE_ID="your_template_id"
VITE_EMAILJS_PUBLIC_KEY="your_public_key"
VITE_FORMSPREE_ENDPOINT="https://formspree.io/f/your_form_id"

# Analytics / Social Links
VITE_GITHUB_URL="https://github.com"
VITE_LINKEDIN_URL="https://linkedin.com"
